# ── Database ───────────────────────────────────────────────────────────────────
# Supabase PostgreSQL connection string (Transaction Pooler, port 6543, sslmode=require)
DATABASE_URL=postgresql+psycopg2://postgres:<password>@<host>:5432/<dbname>

# ── Backend ────────────────────────────────────────────────────────────────────
ENV=development                         # development | production
CORS_ORIGINS=http://localhost:5173      # comma-separated for multiple

# ── Gemini (Phase 4) ───────────────────────────────────────────────────────────
GEMINI_API_KEY=

# ── Razorpay (Phase 5) ─────────────────────────────────────────────────────────
# Use Razorpay Test Mode credentials for local development and verification.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PAYMENT_PROVIDER=mock                         # mock for local development; razorpay for production

# ── Frontend (Vite) ────────────────────────────────────────────────────────────
# Set in frontend/.env or Vercel environment variables
VITE_API_URL=http://localhost:8000
